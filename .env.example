# --- GitHub App (from https://github.com/settings/apps -> your app) ---
# Numeric App ID shown on the app's "General" page
APP_ID=
# Path to the .pem private key you downloaded (keep it out of git)
PRIVATE_KEY_PATH=./private-key.pem
# Same random string you typed into the app's "Webhook secret" field
WEBHOOK_SECRET=
# Your smee.io channel URL, e.g. https://smee.io/AbC123xyz
WEBHOOK_PROXY_URL=

# --- LLM (Groq, free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=
# Optional: change the model without touching code
GROQ_MODEL=llama-3.3-70b-versatile

# --- Local server ---
PORT=3000
